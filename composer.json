{
    "name": "phalcon/bridge-psr3",
    "description": "Phalcon Framework bridge classes for PSR-3",
    "keywords": [
        "php",
        "framework",
        "phalcon",
        "psr-3"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1 <9.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Phalcon\\Bridge\\Psr3\\": "src/",
            "Phalcon\\Bridge\\Psr3\\Tests\\Support\\": "tests/support/",
            "Phalcon\\Bridge\\Psr3\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.99"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require-dev": {
        "infection/infection": "^0.28",
        "pds/skeleton": "^1.0",
        "phalcon/ide-stubs": "^5.6",
        "phalcon/phalcon": "^6.0@alpha",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "phalcon/phalcon": "Provides Phalcon\\Logger via the PHP implementation",
        "ext-phalcon": "Provides Phalcon\\Logger via the C extension (alternative to phalcon/phalcon)"
    },
    "scripts": {
        "analyze": "phpstan analyse -c resources/phpstan.neon --memory-limit 1024M",
        "cs": "phpcs --standard=resources/phpcs.xml",
        "cs-fix": "phpcbf --standard=resources/phpcs.xml",
        "mutation": "infection --configuration=resources/infection.json5 --threads=max",
        "test-unit": "phpunit -c resources/phpunit.xml.dist --testdox",
        "test-coverage-text": "phpunit -c resources/phpunit.xml.dist --testdox --coverage-text",
        "test-coverage-clover": "phpunit -c resources/phpunit.xml.dist --testdox --coverage-clover tests/support/output/clover.xml",
        "test-coverage-html": "phpunit -c resources/phpunit.xml.dist --testdox --coverage-html tests/support/output/"
    }
}
